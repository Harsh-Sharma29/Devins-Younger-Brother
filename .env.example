# ─────────────────────────────────────────────────────────────────────────────
# AutoForge — Environment Configuration
# Copy this file to `.env` and replace placeholder values with real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM API Keys ───────────────────────────────────────────────────────────
# Primary LLM: Google Gemini 2.5 Flash (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternate Gemini key name accepted by LangChain (optional — only set one)
GOOGLE_API_KEY=

# Failover LLM: HuggingFace Meta Llama-3-8B-Instruct (recommended)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Live web search for Coder agent (Tavily — optional but recommended for API docs)
TAVILY_API_KEY=your_tavily_api_key_here

# ─── FastAPI Backend ─────────────────────────────────────────────────────────
# URL where the Streamlit frontend reaches the FastAPI backend.
# Docker Compose sets this to http://autoforge-api:8000 automatically.
AUTOFORGE_API_URL=http://localhost:8000

# ─── Postgres Checkpointer (LangGraph persistent state) ─────────────────────
# Docker Compose overrides this for the `autoforge-api` container.
# For local development against compose Postgres, use the default below.
DATABASE_URL=postgresql://autoforge:autoforge@localhost:5432/autoforge?sslmode=disable
POSTGRES_USER=autoforge
POSTGRES_PASSWORD=autoforge
POSTGRES_DB=autoforge
POSTGRES_PORT=5432

# ─── Docker Sandbox ─────────────────────────────────────────────────────────
# Host directory for generated scripts (defaults to OS temp / autoforge_sandbox)
AUTOFORGE_SANDBOX_DIR=

# ─── Networking ─────────────────────────────────────────────────────────────
# Host ports when using docker compose
STREAMLIT_PORT=8501

# ─── Session ────────────────────────────────────────────────────────────────
# Optional: stable thread_id for CLI invocations (auto-generated if unset)
AUTOFORGE_THREAD_ID=

# LLM Configuration (groq, gemini, openai, anthropic, huggingface)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Optional API Keys for other models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
