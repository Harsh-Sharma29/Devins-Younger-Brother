GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
# Optional: sandbox workspace (defaults to OS temp dir / devin_brother_sandbox)
DYB_SANDBOX_DIR=
# Optional: host port when using docker compose
STREAMLIT_PORT=8501

# Postgres checkpointer (LangGraph persistent state)
# Docker Compose sets this automatically for the app service.
# Local CLI against compose Postgres:
DATABASE_URL=postgresql://devin:devin@localhost:5432/devin_brother?sslmode=disable
POSTGRES_USER=devin
POSTGRES_PASSWORD=devin
POSTGRES_DB=devin_brother
POSTGRES_PORT=5432

# Optional: stable session id for CLI invocations (auto-generated if unset)
DYB_THREAD_ID=
